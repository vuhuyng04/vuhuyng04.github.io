{% comment %}
  Unified references entry renderer for both formats.

  OVERRIDE of al_folio_cv's templates/cv/references.liquid. The bundled version
  renders only `name` and `reference`. This adds three optional fields:

    position  - the referee's role, shown under their name
    url       - links the referee's name out (e.g. their LinkedIn profile)
    evidence  - path under assets/img/ to a screenshot of the original
                recommendation, revealed on hover / tap / keyboard focus

  Everything else is unchanged from the gem.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}

      {% if entry.url %}
        <strong><a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.name }}</a></strong>
      {% else %}
        <strong>{{ entry.name }}</strong>
      {% endif %}

      {% if entry.position %}
        <span class="cv-ref-position">{{ entry.position }}</span>
      {% endif %}

      {% if entry.evidence %}
        <span class="cv-evidence" tabindex="0" role="button" aria-label="Show the original recommendation">
          <i class="fa-solid fa-image"></i>
          evidence
          <span class="cv-evidence-popup" role="tooltip">
            <img src="{{ entry.evidence | prepend: '/assets/img/' | relative_url }}" alt="Original recommendation from {{ entry.name }}" loading="lazy" />
          </span>
        </span>
      {% endif %}

      <p>{{ entry.reference | markdownify | remove: '<p>' | remove: '</p>' }}</p>
    </li>
  {% endfor %}
</ul>
